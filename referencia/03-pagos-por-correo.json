      "id": "00000000-0000-0000-0000-000000000012",
      "name": "¿Es un pago?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://pasteleria:8000/api/encargos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "estado",
              "value": "pendiente"
            }
          ]
        }
      },
      "id": "00000000-0000-0000-0000-000000000013",
      "name": "Encargos pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-api-0001",
          "name": "API Pastelería"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const datos = $('Extraer datos del correo').first().json.output;\nconst pendientes = $input.all().map(i => i.json).filter(e => e.id);\nconst norm = s => (s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9 ]/g, ' ').trim();\n\nlet candidatos = [];\nconst porNumero = norm(datos.concepto).match(/(?:encargo|pedido)\\s*(\\d+)/);\nif (porNumero) {\n  candidatos = pendientes.filter(e => e.id === Number(porNumero[1]));\n} else {\n  // Nombre: el primer nombre coincide y el siguiente apellido empieza igual (sirve \"JORGE M.\")\n  const t = norm(datos.ordenante).split(/\\s+/).filter(Boolean);\n  candidatos = pendientes.filter(e => {\n    const c = norm(e.cliente).split(/\\s+/);\n    return t.length >= 2 && c[0] === t[0] && c.slice(1).some(w => w.startsWith(t[1]) || t[1].startsWith(w));\n  });\n}\n\nconst base = { ordenante: datos.ordenante, importe: datos.importe, forma: datos.forma, concepto: datos.concepto };\nif (candidatos.length !== 1)\n  return [{ json: { ...base, decision: 'revisar', motivo: candidatos.length ? 'Hay varios encargos posibles' : 'No he encontrado ningún encargo pendiente de esa persona' } }];\nconst e = candidatos[0];\nif (datos.importe > e.pendiente)\n  return [{ json: { ...base, decision: 'revisar', encargo_id: e.id, motivo: `Paga ${datos.importe} € pero al encargo #${e.id} solo le faltan ${e.pendiente} €` } }];\nreturn [{ json: { ...base, decision: 'registrar', encargo_id: e.id, motivo: 'Coincide con un único encargo' } }];"
      },
      "id": "00000000-0000-0000-0000-000000000014",
      "name": "Buscar el encargo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
