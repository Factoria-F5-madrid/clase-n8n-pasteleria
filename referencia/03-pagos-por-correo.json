    },
    {
      "parameters": {
        "fromEmail": "pasteleria@lacuchara.example",
        "toEmail": "marisa@lacuchara.example",
        "subject": "=Pago para revisar: {{ $json.importe }} € de {{ $json.ordenante }}",
        "emailFormat": "text",
        "text": "=Hola Marisa,\n\nHa llegado un pago y no lo he registrado.\n\nMotivo: {{ $json.motivo }}\n\nOrdenante: {{ $json.ordenante }}\nImporte: {{ $json.importe }} €\nForma: {{ $json.forma }}\nConcepto: {{ $json.concepto }}\n\nRegístralo tú si es correcto.",
        "options": {
