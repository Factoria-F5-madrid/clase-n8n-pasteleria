# Clave que n8n debe enviar en la cabecera X-API-Key para usar la API de la pastelería
API_KEY=cambia-esta-clave
# Webhook de n8n que recibe los eventos. Es la URL de PRODUCCIÓN: solo funciona con el flujo activado.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/pasteleria
# 1 = cargar encargos de ejemplo la primera vez, 0 = empezar vacío
SEED=1
